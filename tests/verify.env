# 비밀값이 없는 격리 테스트 주소 설정. -p moaje-verify / -p moaje-mock-verify와 함께 사용한다.
MOAJE_STACK_PREFIX=moaje-verify
MOAJE_MOCK_PREFIX=moaje-verify-mock
GATEWAY_PORT=18080
ASSET_MYSQL_PORT=13307
BANKING_MYSQL_PORT=13308
REDIS_PORT=16379
KAFKA_PORT=19092
MOCK_API_PORT=18081
MOCK_REDIS_PORT=16380
MOAJE_MOCK_BASE_URL=http://host.docker.internal:18081/
MOAJE_GRPC_CERTS_DIR=./.local/verify-certs
MOAJE_SMOKE_DIR=./.local/verify-smoke
