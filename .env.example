# Auth의 JWT와 Gateway는 아래 값을 동일하게 사용한다. 실제 비밀키는 이 파일에 넣지 않는다.
AUTH_JWT_ISSUER=moaje-auth
# audience: Auth에서 JWT_AUDIENCE를 사용할 때 같은 값을 입력한다. 비어 있으면 aud 검사를 하지 않는다.
AUTH_JWT_AUDIENCE=
# 현재 Auth 기본 서명 방식. HS256에서는 Auth의 SECRET_KEY와 같은 32바이트 이상의 값을 별도 환경변수로 주입한다.
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_SECRET_KEY=
# 향후 RS/ES 서명으로 전환할 때 Auth가 공개하는 JWKS의 HTTPS URL을 입력한다.
AUTH_JWT_JWK_SET_URI=
# 자체 자격정보로 동작하는 API만 정확한 METHOD와 외부 경로로 등록한다. account-token API는 포함하지 않는다.
AUTH_PUBLIC_ENDPOINTS=POST /api/v1/auth/register,POST /api/v1/auth/login,POST /api/v1/auth/refresh,POST /api/v1/auth/logout,POST /api/v1/auth/token/validate,GET /api/v1/auth/token/validate
# Compose 내부에서는 서비스 이름으로 통신한다. 로컬에서 Gateway만 실행할 때는 http://localhost:8000을 사용한다.
AUTH_SERVICE_URI=http://auth:8000
# Auth가 accountToken을 암호화할 때 사용하는 URL-safe Base64 32바이트 키다. 실제 값은 커밋하지 않는다.
AUTH_AES_MASTER_KEY=

# local/test 전용 페르소나 생성 Port와 Console이 공유하는 값이다. 운영 환경에는 Fixture 기능을 배포하지 않는다.
MOAJE_FIXTURE_ADMIN_TOKEN=moaje-local-fixture-token
TEST_FIXTURE_CONSOLE_PORT=8090
# Auth MySQL의 호스트 공개 포트다. 컨테이너끼리는 auth-mysql:3306을 사용한다.
AUTH_MYSQL_PORT=3309
# 외부 거래 조회 기본 30초. 실제 지연에는 대기 계좌 수와 통신 시간이 추가된다.
ASSET_PROJECTION_AUDIT_INTERVAL_MS=30000

# Work 전용 MySQL. 아래 기본값은 로컬 개발용이며 운영용 비밀번호가 아니다.
# DATABASE_URL에 포함되므로 비밀번호는 URL-safe 문자로 지정한다. 기존 볼륨의 비밀번호는 환경변수만 바꿔도 갱신되지 않는다.
WORK_MYSQL_PASSWORD=moaje-work-local
WORK_MYSQL_ROOT_PASSWORD=moaje-work-local-root
# Work 운영 API 전용. 미설정이면 블랙리스트·운영 지표 API는 503으로 차단한다.
# JWT와 별개이며 클라이언트 앱이나 Git에 값을 공유하지 않는다.
WORK_INTERNAL_TOKEN=
