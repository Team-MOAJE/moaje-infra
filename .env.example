# Auth 회의 후 입력할 값이다. 이 파일에 실제 JWT 또는 비밀키를 넣지 않는다.
# issuer: JWT의 iss와 정확히 같은 발급자 문자열.
AUTH_JWT_ISSUER=
# audience: 이번 API용 토큰의 aud. 다른 앱용 토큰을 받지 않기 위한 검사 값.
AUTH_JWT_AUDIENCE=
# Auth가 공개하는 JWKS의 HTTPS URL. Gateway 컨테이너에서도 접속할 수 있어야 한다.
AUTH_JWT_JWK_SET_URI=
# 합의한 비대칭 서명 알고리즘(예: RS256). 빈 값에서는 인증이 차단된다.
AUTH_JWT_ALGORITHM=
# 로그인/갱신의 정확한 METHOD와 경로를 쉼표로 구분. /auth/** 같은 포괄 예외는 사용하지 않는다.
AUTH_PUBLIC_ENDPOINTS=
# 외부 거래 조회 기본 30초. 실제 지연에는 대기 계좌 수와 통신 시간이 추가된다.
ASSET_PROJECTION_AUDIT_INTERVAL_MS=30000
